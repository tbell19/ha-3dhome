{
  "name": "ha-3dhome",
  "version": "6.2.4",
  "private": true,
  "description": "3D Home: a live 3D floor plan card and dashboard strategy for Home Assistant, with an editor built in",
  "type": "commonjs",
  "scripts": {
    "build": "node tools/build.js",
    "test": "node tools/smoke-test.js",
    "test:mobile": "node tools/smoke-test.js --mobile",
    "test:leaks": "node tools/leak-test.js",
    "test:plan": "node tools/plan-test.js",
    "test:panel": "node tools/panel-test.js",
    "shots:looks": "node tools/look-shots.js",
    "demo": "node tools/demo.js",
    "test:demo": "node tools/demo-test.js",
    "test:all": "sh tools/all-tests.sh",
    "format": "prettier --write src tools",
    "format:check": "prettier --check src tools",
    "typecheck": "tsc -p tsconfig.strict.json && tsc -p .",
    "test:py": "${PYTHON:-python3} -m pytest -q -p no:cacheprovider"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/three": "0.160.0",
    "esbuild": "0.24.0",
    "js-yaml": "4.1.0",
    "jszip": "3.10.1",
    "playwright": "^1.47.0",
    "preact": "10.24.3",
    "prettier": "3.3.3",
    "terser": "^5.31.0",
    "three": "0.160.0",
    "typescript": "5.6.3"
  }
}
